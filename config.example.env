# =============================================================================
# SFSR MCP-server — konfigurationsmall
# Kopiera till .env och fyll i dina egna värden.
# .env checkas aldrig in i Git.
# =============================================================================

# ---------------------------------------------------------------------------
# Databasanslutning
# ---------------------------------------------------------------------------
# PostgreSQL
DATABASE_URL=postgresql://<DB_ANVANDARE>:<DB_LOSENORD>@localhost:5432/<DB_NAMN>

# SQLite (ingen extra installation krävs)
# DATABASE_URL=sqlite:///sfsr_cache.db

# ---------------------------------------------------------------------------
# SFSR-datakälla
# ---------------------------------------------------------------------------
# "api"  : anropar beta.rkrattsbaser.gov.se — strukturerad JSON, bättre data
# "html" : skrapar rkrattsbaser.gov.se — alternativ om API:et ändras
SFSR_BACKEND=api

# Bas-URL för HTML-alternativet (ändras bara om sajten byter adress)
SFSR_BASE_URL=https://rkrattsbaser.gov.se/sfsr

# URL för API-alternativet
SFSR_API_URL=https://beta.rkrattsbaser.gov.se/elasticsearch/SearchEsByRawJson

# Cache-TTL i timmar — hur länge en cachad SFSR-post anses giltig.
# Ändringsregistret uppdateras när riksdagen antar ny lagstiftning.
# Standard 24 h innebär att du aldrig arbetar med mer än ett dygn gammal data.
SFSR_CACHE_TTL_HOURS=24

# User-Agent för HTTP-anrop till rkrattsbaser.gov.se
USER_AGENT=mcp-for-rkrattsdatabaser-sfsr/1.0 (+https://github.com/MagnusKolsjo/mcp-for-rkrattsdatabaser-sfsr)

# ---------------------------------------------------------------------------
# MCP-transport
# ---------------------------------------------------------------------------
# "stdio" : MCP-klienten startar processen — för lokal användning
# "http"  : servern lyssnar på MCP_HOST:MCP_PORT — för hostad driftsättning
MCP_TRANSPORT=stdio

# Används bara i http-läget:
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_API_KEY=<API_NYCKEL>  # generera med: python3 -c "import secrets; print(secrets.token_hex(32))"
