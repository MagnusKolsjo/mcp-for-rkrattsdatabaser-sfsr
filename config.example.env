# =============================================================================
# SFSR MCP-server — konfigurationsmall
# Kopiera till .env och fyll i dina egna värden.
# .env checkas aldrig in i Git.
# =============================================================================

# ---------------------------------------------------------------------------
# Databasanslutning
# ---------------------------------------------------------------------------
# PostgreSQL (rekommenderas)
DATABASE_URL=postgresql://mitt_db_anvandare:byt_till_eget_starkt_losenord@localhost:5432/riksdag

# SQLite (fallback — ingen extra installation krävs)
# DATABASE_URL=sqlite:///sfsr_cache.db

# ---------------------------------------------------------------------------
# SFSR-datakälla
# ---------------------------------------------------------------------------
# "api"  (standard): anropar beta.rkrattsbaser.gov.se — strukturerad JSON, bättre data
# "html"            : skrapar rkrattsbaser.gov.se — reserv om API:et ändras
SFSR_BACKEND=api

# Bas-URL för HTML-backenden (ändras bara om sajten byter adress)
SFSR_BASE_URL=https://rkrattsbaser.gov.se/sfsr

# URL för API-backenden
SFSR_API_URL=https://beta.rkrattsbaser.gov.se/elasticsearch/SearchEsByRawJson

# Cache-TTL i timmar — hur länge en cachad SFSR-post anses giltig.
# Ändringsregistret uppdateras när riksdagen antar ny lagstiftning.
# Standard 24 h innebär att du aldrig arbetar med mer än ett dygn gammal data.
SFSR_CACHE_TTL_HOURS=24

# User-Agent för HTTP-anrop
USER_AGENT=Mozilla/5.0 (compatible; sfsr-mcp-bot/1.0)

# ---------------------------------------------------------------------------
# MCP-transport
# ---------------------------------------------------------------------------
# "stdio" (standard): MCP-klienten startar processen — för lokal användning
# "http"            : servern lyssnar på MCP_HOST:MCP_PORT — för hostad driftsättning
MCP_TRANSPORT=stdio

# Används bara i http-läget:
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_API_KEY=  # generera med: python3 -c "import secrets; print(secrets.token_hex(32))"
